{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trigenys.com/schemas/appfactory-landing.schema.json",
  "title": "AppFactory Landing Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "strategy",
    "brand",
    "design",
    "sections",
    "seo",
    "motion",
    "content",
    "hero",
    "features",
    "finalCta"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "language"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "language": { "enum": ["fr", "en"] }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "audience", "industry", "tone", "goal"],
      "properties": {
        "brief": { "type": "string", "minLength": 1 },
        "audience": { "type": ["string", "null"] },
        "industry": {
          "enum": [
            "legal",
            "technology",
            "finance",
            "healthcare",
            "education",
            "logistics",
            "real-estate",
            "ecommerce",
            "hospitality",
            "creative",
            "general"
          ]
        },
        "tone": { "enum": ["professional", "premium", "bold", "friendly", "minimal"] },
        "goal": { "enum": ["leads", "bookings", "sales", "signup", "contact", "awareness"] }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "palette", "typography"],
      "properties": {
        "tone": { "enum": ["professional", "premium", "bold", "friendly", "minimal"] },
        "palette": { "enum": ["navy-mint", "midnight-gold", "electric-indigo"] },
        "typography": { "enum": ["grotesk", "editorial", "geometric"] }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "animation", "density"],
      "properties": {
        "recipe": { "enum": ["corporate", "luxury", "saas"] },
        "animation": { "enum": ["none", "subtle", "expressive"] },
        "density": { "enum": ["airy", "balanced"] }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "hero",
          "trust",
          "services",
          "features",
          "process",
          "testimonials",
          "pricing",
          "faq",
          "contact",
          "final-cta"
        ]
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 70 },
        "description": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "respectReducedMotion"],
      "properties": {
        "level": { "enum": ["none", "subtle", "expressive"] },
        "respectReducedMotion": { "type": "boolean" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero", "trust", "services", "features", "process", "faq", "contact", "finalCta"],
      "properties": {
        "hero": { "$ref": "#/$defs/hero" },
        "trust": { "$ref": "#/$defs/trustSection" },
        "services": { "$ref": "#/$defs/cardSection" },
        "features": { "$ref": "#/$defs/cardSection" },
        "process": { "$ref": "#/$defs/processSection" },
        "faq": { "$ref": "#/$defs/faqSection" },
        "contact": { "$ref": "#/$defs/contactSection" },
        "finalCta": { "$ref": "#/$defs/finalCta" }
      }
    },
    "hero": { "$ref": "#/$defs/hero" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cardItem" }
    },
    "finalCta": { "$ref": "#/$defs/finalCta" }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "primaryCta"],
      "properties": {
        "eyebrow": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "primaryCta": { "$ref": "#/$defs/cta" },
        "secondaryCta": { "$ref": "#/$defs/cta" }
      }
    },
    "cardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "cardSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cardItem" }
        }
      }
    },
    "trustSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "processSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "steps"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cardItem" }
        }
      }
    },
    "faqSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contactSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "cta"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "cta": { "$ref": "#/$defs/cta" }
      }
    },
    "finalCta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "label", "href"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 }
      }
    }
  }
}
