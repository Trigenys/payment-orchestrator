{
  "name": "@trigenys/payment-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test && npm run check:contracts && npm run check:sdk",
    "check:contracts": "npm run check --workspace @trigenys/payments-contracts",
    "check:sdk": "npm run check --workspace @trigenys/payments",
    "db:migrate": "node dist/src/storage/postgres/migrate.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.151.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "pg": "^8.23.1"
  }
}
